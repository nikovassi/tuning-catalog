# Публичен адрес на сайта (за canonical, sitemap, Open Graph). Без наклонена черта накрая.
VITE_SITE_URL=https://USERNAME.github.io/tuning-catalog
# Base path за GitHub Pages (името на repo-то). За собствен домейн: /
BASE_PATH=/tuning-catalog/
# Endpoint за запитвания (Formspree, Netlify function, Cloudflare Worker, собствен API...).
# Приема POST JSON. Ако е празно, формата използва mailto към site.email (ако е попълнен).
VITE_INQUIRY_ENDPOINT=
